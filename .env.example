DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/khma"
# 32 random bytes, base64: openssl rand -base64 32
KHMA_ENCRYPTION_KEY=""

# Optional
APP_URL="http://localhost:3100"
# Mail (same as Upla): SMTP_HOST wins, else SendGrid
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="Loudpilot <no-reply@example.com>"
# SENDGRID_API_KEY=""
# SENDGRID_FROM="verified-sender@example.com"
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-flash-latest"

# Meta app (Facebook Pages, Instagram, Meta Ads). Redirect URI to register:
#   {APP_URL}/auth/meta/callback
# Deauthorize callback: {APP_URL}/api/meta/deauthorize
# Data deletion callback: {APP_URL}/api/meta/data-deletion
# META_APP_ID=""
# META_APP_SECRET=""
# META_CONFIG_ID=""        # Facebook Login for Business configuration (instead of scopes)
# META_GRAPH_VERSION="v26.0"
# META_SCOPES=""           # comma-separated override of the default scopes

# Background ticker (scheduled publishing, insights): on by default
# KHMA_SCHEDULER=off
# Automatic AI audits after connecting accounts and weekly: on by default
# KHMA_AUTO_AUDIT=off
# Monday weekly reviews: on by default
# KHMA_AUTO_REVIEW=off

# Legal pages: registered operator of the service
# LEGAL_ENTITY=""
# LEGAL_ENTITY_ID=""
# LEGAL_ADDRESS=""

# More channels (each turns on when its credentials are set)
# Telegram: works with each company's own bot; set to offer Loudpilot's bot too.
TELEGRAM_BOT_TOKEN=
# TikTok Login Kit + Content Posting API. TIKTOK_PHOTOS=1 once the media domain is verified.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_PHOTOS=
# LinkedIn (Share on LinkedIn). LINKEDIN_PAGES=1 after Community Management API approval.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_PAGES=
# X API v2 (OAuth 2.0, confidential client)
X_CLIENT_ID=
X_CLIENT_SECRET=
# Threads (separate Meta app with the "Access the Threads API" use case)
THREADS_APP_ID=
THREADS_APP_SECRET=
# Pinterest API v5
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# YouTube uses the Google OAuth client; set to 1 once the YouTube scopes are on the consent screen.
YOUTUBE_ENABLED=
