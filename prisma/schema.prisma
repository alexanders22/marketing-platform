generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Partners ────────────────────────────────────────────────────────────────
// A connected product (Upla, Zavnili, Dotcom…) that uses Khma through the API.
// SINGLE: the partner itself is one advertiser (one workspace).
// MULTI:  a reseller whose own customers/profiles each get a workspace
//         (Upla: every company and every broker profile).

enum PartnerMode {
  SINGLE
  MULTI
}

enum PartnerStatus {
  ACTIVE
  SUSPENDED
}

model Partner {
  id              String        @id @default(cuid())
  name            String
  slug            String        @unique
  mode            PartnerMode   @default(SINGLE)
  status          PartnerStatus @default(ACTIVE)
  // Share of credit purchases paid out to the partner (0–100).
  revenueSharePct Float         @default(0)
  webhookUrl      String?
  webhookSecret   String?
  // Set for an Agency customer's own API access: workspaces it creates belong
  // to this account, and keys work only while the plan allows the API.
  ownerAccountId  String?       @unique
  ownerAccount    Account?      @relation("PartnerOwner", fields: [ownerAccountId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  apiKeys    ApiKey[]
  workspaces Workspace[]
  accounts   Account[]
}

model ApiKey {
  id         String    @id @default(cuid())
  partnerId  String
  partner    Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  name       String
  // First characters of the key, shown in UI to tell keys apart.
  prefix     String
  // sha256 of the full key; the key itself is never stored.
  keyHash    String    @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([partnerId])
}

// ─── Accounts (who pays) ─────────────────────────────────────────────────────
// The registered customer that owns credits. Created by the short signup a
// partner profile goes through, or directly on the platform.

model Account {
  id              String       @id @default(cuid())
  name            String
  email           String
  country         String?
  currency        String       @default("GEL")
  // Partner the customer came through — drives revenue share. Null = direct.
  partnerId       String?
  partner         Partner?     @relation(fields: [partnerId], references: [id])
  // Cached sum of CreditEntry.amount, updated in the same transaction.
  creditBalance   Int          @default(0)
  termsAcceptedAt DateTime?
  plan            Plan         @default(NONE)
  billingCycle    BillingCycle @default(MONTHLY)
  trialEndsAt     DateTime?
  // Email account owners and admins when an alert fires.
  alertEmails     Boolean      @default(true)
  // Paused by a super admin: members are locked out, nothing publishes,
  // syncs or spends credits until it is resumed.
  pausedAt        DateTime?
  pausedReason    String?
  // Paid through this date (booked by a super admin until card payments
  // exist). Plan credits are granted each month while it is in the future.
  paidUntil       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  workspaces  Workspace[]
  credits     CreditEntry[]
  members     AccountMember[]
  invitations Invitation[]
  // Self-serve API access (Agency plan): the account acts as its own partner.
  apiPartner  Partner?     @relation("PartnerOwner")

  @@index([partnerId])
}

enum Plan {
  NONE
  STARTER
  TEAM
  AGENCY
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum CreditReason {
  PURCHASE
  REFUND
  GRANT
  AI_TEXT
  AI_IMAGE
  AI_VIDEO
  AI_BLOG
  ADJUSTMENT
}

model CreditEntry {
  id             String       @id @default(cuid())
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // Positive = top-up, negative = spend.
  amount         Int
  reason         CreditReason
  workspaceId    String?
  refType        String?
  refId          String?
  // Same key twice never books twice (retries, double clicks, webhook replays).
  idempotencyKey String?      @unique
  note           String?
  // Spend: which priced action (src/lib/pricing.ts) and how many units
  // (images, seconds of clip…) — for unit economics in the admin.
  action         String?
  units          Float?
  createdAt      DateTime     @default(now())

  @@index([accountId, createdAt])
}

// ─── Workspaces (who advertises) ─────────────────────────────────────────────

model Workspace {
  id         String   @id @default(cuid())
  name       String
  // Null for direct customers; set for workspaces created through a partner.
  partnerId  String?
  partner    Partner? @relation(fields: [partnerId], references: [id])
  // The partner's own id for this profile (Upla company / broker profile id).
  externalId String?
  // Null until the profile completes signup; spending credits needs it.
  accountId  String?
  account    Account? @relation(fields: [accountId], references: [id])
  locale     String   @default("ka")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  brandKit         BrandKit?
  socialAccounts   SocialAccount[]
  hashtagLibraries HashtagLibrary[]
  media            Media[]
  posts            Post[]
  campaigns        Campaign[]
  designs          Design[]
  videos           Video[]
  clipJobs         ClipJob[]
  characters       Character[]
  competitors      Competitor[]
  brandbook        Brandbook?
  competitorReports CompetitorReport[]
  bioPages         BioPage[]
  adCampaigns      AdCampaign[]
  websiteDays      WebsiteDay[]
  boosts           Boost[]
  websiteAudits    WebsiteAudit[]
  aiSummaries      AiSummary[]
  goals            Goal[]
  alerts           Alert[]
  brandProfile     BrandProfile?
  socialPosts      SocialPost[]
  brandAudits      BrandAudit[]
  strategyPlans    StrategyPlan[]
  weeklyReviews    WeeklyReview[]
  recommendations  Recommendation[]
  accessTokens     AccessToken[]
  mcpRequests      McpRequest[]
  conversations    Conversation[]
  brandFacts       BrandFact[]

  @@unique([partnerId, externalId])
  @@index([accountId])
}

model BrandKit {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  website     String?
  description String?
  voice       String?
  audience    String?
  colors      String[]
  fonts       String[]
  logoUrl     String?
  // Public profile URLs found on the website or added by hand.
  socialLinks String[]
  updatedAt   DateTime  @updatedAt
}

// Named, reusable hashtag sets ("Spring sale", "Brand basics") the composer
// can append to a post.
model HashtagLibrary {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  tags        String[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
}

enum MediaKind {
  IMAGE
  VIDEO
  AUDIO
}

// A generated or uploaded file. Bytes live on disk under STORAGE_DIR; the
// row is what access checks go through.
model Media {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind        MediaKind @default(IMAGE)
  mime        String
  path        String
  bytes       Int
  prompt      String?
  // Pixels and length, when known (videos and audio).
  width       Int?
  height      Int?
  durationMs  Int?
  // Videos: a still frame for lists and previews.
  posterId    String?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
}

enum ContentKind {
  SOCIAL
  BLOG
}

enum PostStatus {
  DRAFT
  SCHEDULED
  // Claimed by the publisher; becomes PUBLISHED or FAILED.
  PUBLISHING
  PUBLISHED
  FAILED
}

// A social post or a blog article. `scheduledAt` is the planned date shown in
// the Planner; it becomes a real publish time once channels are connected.
model Post {
  id          String      @id @default(cuid())
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaignId  String?
  campaign    Campaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  kind        ContentKind @default(SOCIAL)
  status      PostStatus  @default(DRAFT)
  title       String?
  // Blog campaign items start as an outline until the article is written.
  outline     String?
  content     String      @default("")
  hashtags    String[]
  mediaIds    String[]
  // Networks the post is meant for (FACEBOOK, INSTAGRAM, …).
  channels    String[]
  // Call to action: { type, url?, phone? } — see src/lib/cta.ts.
  cta         Json?
  scheduledAt DateTime?
  aiGenerated Boolean     @default(false)
  createdById String?
  publishedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  deliveries PostDelivery[]

  @@index([workspaceId, scheduledAt])
  @@index([status, scheduledAt])
  @@index([campaignId])
}

enum DeliveryStatus {
  PUBLISHED
  FAILED
}

// One post on one connected account: the network's post id, link, error
// and the latest insights we read back.
model PostDelivery {
  id              String         @id @default(cuid())
  postId          String
  post            Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccountId String
  socialAccount   SocialAccount  @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  status          DeliveryStatus
  externalId      String?
  permalink       String?
  error           String?
  // { reach, views, likes, comments, shares, saves, interactions }
  metrics         Json?
  metricsAt       DateTime?
  createdAt       DateTime       @default(now())
  boosts          Boost[]

  @@unique([postId, socialAccountId])
  @@index([socialAccountId, createdAt])
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

// A run of social posts or blog articles planned around one goal.
model Campaign {
  id           String         @id @default(cuid())
  workspaceId  String
  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind         ContentKind    @default(SOCIAL)
  name         String
  brief        String
  startsOn     DateTime
  endsOn       DateTime
  postsPerWeek Int
  tone         String
  language     String
  status       CampaignStatus @default(DRAFT)
  // Call to action every post of the campaign ends with.
  cta          Json?
  // AI images for the posts, made in the background: GENERATING → DONE.
  imageStatus  String?
  imagesDone   Int            @default(0)
  imagesTotal  Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  posts Post[]

  @@index([workspaceId, startsOn])
}

// A Studio canvas: size plus a JSON list of layers (text, image, shape).
model Design {
  id             String    @id @default(cuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name           String
  width          Int
  height         Int
  data           Json
  previewMediaId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([workspaceId, updatedAt])
}

// Public link-in-bio page at /b/{slug}. `blocks` is a JSON list of links,
// headings, text and social rows; `theme` holds colours and button style.
model BioPage {
  id            String    @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  slug          String    @unique
  title         String
  bio           String    @default("")
  avatarMediaId String?
  theme         Json
  blocks        Json
  published     Boolean   @default(false)
  views         Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  clicks BioClick[]

  @@index([workspaceId])
}

model BioClick {
  id        String   @id @default(cuid())
  pageId    String
  page      BioPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  blockId   String
  createdAt DateTime @default(now())

  @@index([pageId, blockId])
}

enum SocialNetwork {
  FACEBOOK
  INSTAGRAM
  META_ADS
  // A Google Analytics 4 property: website visits and key events.
  GOOGLE_ANALYTICS
  // A Google Search Console site: searches, clicks and positions.
  SEARCH_CONSOLE
  TIKTOK
  LINKEDIN
  YOUTUBE
  TELEGRAM
  X
}

enum ConnectionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

model SocialAccount {
  id              String           @id @default(cuid())
  workspaceId     String
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  network         SocialNetwork
  // Page / profile / channel / ad account id on the network.
  externalId      String
  name            String
  handle          String?
  avatarUrl       String?
  // Meta: the app-scoped id of the person who connected it (deauthorize and
  // data-deletion callbacks name this id). Instagram: its Facebook Page id.
  connectedBy     String?
  parentId        String?
  // Network specifics, e.g. ad account currency and time zone.
  meta            Json?
  // AES-256-GCM encrypted (see src/lib/crypto.ts).
  accessTokenEnc  String?
  refreshTokenEnc String?
  expiresAt       DateTime?
  scopes          String[]
  status          ConnectionStatus @default(ACTIVE)
  lastError       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  deliveries  PostDelivery[]
  adCampaigns AdCampaign[]
  boosts      Boost[]
  websiteDays WebsiteDay[]
  // Ad accounts: when campaigns and insights were last read.
  syncedAt    DateTime?
  socialPosts SocialPost[]
  // When post history was last read.
  historyAt   DateTime?
  conversations Conversation[]
  // Inbox: last read of conversations, and why it failed (e.g. no permission).
  inboxSyncedAt DateTime?
  inboxError    String?

  @@unique([workspaceId, network, externalId])
  @@index([connectedBy])
}

// Meta "delete my data" requests: the confirmation code Meta shows the
// person, so they can check the status on /data-deletion.
model MetaDeletion {
  id          String    @id @default(cuid())
  code        String    @unique
  metaUserId  String
  completedAt DateTime?
  createdAt   DateTime  @default(now())
}

// ─── Platform users (direct UI login) ────────────────────────────────────────
// Partner profiles never log in here — the partner authenticates them and
// calls the API. These are for direct customers and Khma staff.

enum UserRole {
  SUPER_ADMIN
  USER
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  passwordHash    String?
  googleId        String?   @unique
  emailVerifiedAt DateTime?
  role            UserRole  @default(USER)
  // Blocked by a super admin: can't sign in, sessions and tokens stop working.
  disabledAt      DateTime?
  createdAt       DateTime  @default(now())

  memberships  AccountMember[]
  sessions     Session[]
  accessTokens AccessToken[]
}

enum LinkPurpose {
  LOGIN
  PASSWORD_RESET
}

// One-time link sent by email (sign-in or password reset). Only the token
// hash is stored.
model MagicLink {
  id        String      @id @default(cuid())
  purpose   LinkPurpose @default(LOGIN)
  email     String
  tokenHash String      @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime    @default(now())

  @@index([email, createdAt])
}

// Browser login session. The cookie holds a random token; only its sha256 is
// stored, so a database leak does not leak live sessions.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum MemberRole {
  OWNER
  ADMIN
  EDITOR
}

model AccountMember {
  id        String     @id @default(cuid())
  accountId String
  account   Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      MemberRole @default(EDITOR)

  @@unique([accountId, userId])
}

// A teammate invited by email. The link (only its sha256 is stored) signs
// them in and adds them to the account with the given role.
model Invitation {
  id          String     @id @default(cuid())
  accountId   String
  account     Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  email       String
  role        MemberRole @default(EDITOR)
  tokenHash   String     @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime   @default(now())

  @@index([accountId, email])
}

// ─── Ads & analytics ─────────────────────────────────────────────────────────

// A campaign in a connected ad account, as last read from the network.
model AdCampaign {
  id              String        @id @default(cuid())
  workspaceId     String
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialAccountId String
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  externalId      String
  name            String
  // Network objective, e.g. OUTCOME_LEADS.
  objective       String?
  // Network delivery status, e.g. ACTIVE, PAUSED, CAMPAIGN_PAUSED.
  status          String
  // Account currency, in major units (₾12.50 → 12.5).
  dailyBudget     Float?
  lifetimeBudget  Float?
  currency        String?
  startsAt        DateTime?
  endsAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  days   AdInsightDay[]
  goals  Goal[]
  ads    AdItem[]
  boosts Boost[]

  @@unique([socialAccountId, externalId])
  @@index([workspaceId])
}

// One day of results for one ad campaign (in the ad account's time zone).
model AdInsightDay {
  id          String     @id @default(cuid())
  campaignId  String
  campaign    AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  // YYYY-MM-DD in the ad account's time zone.
  date        String
  spend       Float      @default(0)
  impressions Int        @default(0)
  reach       Int        @default(0)
  clicks      Int        @default(0)
  // The objective's result (leads, purchases, link clicks …) and its value.
  results     Int        @default(0)
  resultType  String?
  revenue     Float      @default(0)
  // Raw action counts for later breakdowns.
  actions     Json?

  @@unique([campaignId, date])
  @@index([date])
}

// AI-written summary of a dashboard period.
model AiSummary {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  periodDays  Int
  text        String
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
}

// ─── Goals & alerts ──────────────────────────────────────────────────────────

enum GoalScope {
  // One ad campaign, all ads of the workspace, published posts, or the
  // website (Google Analytics).
  CAMPAIGN
  ADS
  POSTS
  WEBSITE
}

enum GoalStatus {
  NO_DATA
  ON_TRACK
  AT_RISK
  OFF_TRACK
}

// A target the owner sets, e.g. "cost per lead at most ₾5 over 7 days" or
// "average reach per Instagram post at least 1,000". Checked every hour.
model Goal {
  id           String      @id @default(cuid())
  workspaceId  String
  workspace    Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  scope        GoalScope
  adCampaignId String?
  adCampaign   AdCampaign? @relation(fields: [adCampaignId], references: [id], onDelete: Cascade)
  // POSTS: FACEBOOK / INSTAGRAM, or null for both. WEBSITE: one key event
  // name (e.g. sign_up), or null for all key events.
  network      String?
  // See src/lib/goals.ts METRICS.
  metric       String
  // true: the value must stay at or below target (costs); false: at least.
  atMost       Boolean
  target       Float
  // Rolling window in days (1, 7, 30).
  windowDays   Int         @default(7)
  active       Boolean     @default(true)
  // Last evaluation.
  status       GoalStatus  @default(NO_DATA)
  actual       Float?
  checkedAt    DateTime?
  createdById  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  alerts Alert[]

  @@index([workspaceId])
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

model Alert {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  goalId      String?
  goal        Goal?         @relation(fields: [goalId], references: [id], onDelete: SetNull)
  // goal_off_track, goal_at_risk, goal_recovered, campaign_rejected,
  // campaign_issues, account_disconnected, post_failed
  kind        String
  severity    AlertSeverity
  title       String
  body        String
  // Link inside the app (dashboard, campaign, post, channels).
  href        String?
  // Prevents the same alert twice (e.g. one per goal per status change).
  dedupeKey   String?
  readAt      DateTime?
  emailedAt   DateTime?
  webhookAt   DateTime?
  createdAt   DateTime      @default(now())

  @@unique([workspaceId, dedupeKey])
  @@index([workspaceId, createdAt])
}

// ─── Dossier & strategist ───────────────────────────────────────────────────

// What Khma knows about the company: read from its website (several pages)
// and summarised by AI. See src/lib/dossier.ts for the data shape.
model BrandProfile {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  data        Json
  // Pages read for it.
  sources     String[]
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())
}

// A post on a connected account — published before Khma or through it —
// with its latest results. The memory the audit learns from.
model SocialPost {
  id              String        @id @default(cuid())
  workspaceId     String
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialAccountId String
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  externalId      String
  network         String
  // IMAGE, VIDEO, REEL, CAROUSEL, TEXT, LINK
  format          String
  text            String        @default("")
  permalink       String?
  imageUrl        String?
  publishedAt     DateTime
  // { reach, views, likes, comments, shares, saves, engagements }
  metrics         Json
  // Published from Khma (matches a PostDelivery).
  fromKhma        Boolean       @default(false)
  updatedAt       DateTime      @updatedAt

  @@unique([socialAccountId, externalId])
  @@index([workspaceId, publishedAt])
}

// One ad (creative) with its last-90-day results.
model AdItem {
  id          String     @id @default(cuid())
  campaignId  String
  campaign    AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  externalId  String
  name        String
  status      String
  title       String?
  body        String?
  imageUrl    String?
  cta         String?
  spend       Float      @default(0)
  impressions Int        @default(0)
  clicks      Int        @default(0)
  results     Int        @default(0)
  updatedAt   DateTime   @updatedAt

  @@unique([campaignId, externalId])
}

// The AI audit of everything above: what works, what to avoid.
model BrandAudit {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Numbers computed by Khma (formats, times, top/bottom posts …).
  stats       Json
  // AI reading of them.
  data        Json
  postsCount  Int
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
}

enum PlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// A strategy for one business goal: diagnosis, audiences, budget, ads,
// content and goals. Items are applied one by one by the owner.
model StrategyPlan {
  id          String     @id @default(cuid())
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title       String
  goal        String
  objective   String
  budget      Float?
  currency    String?
  startsOn    String
  endsOn      String
  status      PlanStatus @default(DRAFT)
  // Plan body (see src/lib/strategist.ts) incl. which parts were applied.
  data        Json
  createdById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([workspaceId, createdAt])
}

// ─── Weekly review ───────────────────────────────────────────────────────────

// Monday's look back at the last seven days, written by the AI from the
// numbers in `stats`.
model WeeklyReview {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // YYYY-MM-DD in the workspace's time zone.
  weekStart   String
  weekEnd     String
  stats       Json
  // headline, summary, wins, issues
  data        Json
  createdAt   DateTime  @default(now())

  recommendations Recommendation[]

  @@index([workspaceId, weekEnd])
}

enum RecommendationStatus {
  OPEN
  APPLIED
  DISMISSED
  // Replaced by a newer review before anyone acted on it.
  EXPIRED
}

// One concrete next step. Some apply themselves (a post becomes a Planner
// draft, a goal starts being watched); the rest are steps the owner does
// and marks done.
model Recommendation {
  id          String               @id @default(cuid())
  workspaceId String
  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  reviewId    String
  review      WeeklyReview         @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  // post, repeat, goal, budget, creative, pause, other
  kind        String
  title       String
  why         String
  // high, medium, low
  impact      String
  payload     Json
  status      RecommendationStatus @default(OPEN)
  // Post or goal it became.
  appliedRef  String?
  decidedAt   DateTime?
  createdAt   DateTime             @default(now())

  @@index([workspaceId, status])
}

// ─── MCP & personal access ───────────────────────────────────────────────────

enum AccessTokenKind {
  // Created by the user in Settings (Claude Code, Codex, VS Code …).
  PERSONAL
  // Issued through OAuth to an AI app (Claude, ChatGPT, Cursor …).
  OAUTH
}

// A user's key to one workspace for the MCP server. Only hashes are stored.
model AccessToken {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind        AccessTokenKind
  name        String
  prefix      String
  tokenHash   String          @unique
  // OAuth only: the client and its refresh token.
  clientId    String?
  refreshHash String?         @unique
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime        @default(now())

  requests McpRequest[]

  @@index([userId])
  @@index([workspaceId])
}

// An AI app registered itself through OAuth dynamic client registration.
model OAuthClient {
  id           String   @id @default(cuid())
  name         String
  redirectUris String[]
  createdAt    DateTime @default(now())
}

model OAuthCode {
  id            String    @id @default(cuid())
  codeHash      String    @unique
  clientId      String
  userId        String
  workspaceId   String
  redirectUri   String
  codeChallenge String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())
}

// One MCP call, for the usage chart and abuse checks.
model McpRequest {
  id          String       @id @default(cuid())
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tokenId     String?
  token       AccessToken? @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  method      String
  tool        String?
  ok          Boolean
  ms          Int
  createdAt   DateTime     @default(now())

  @@index([workspaceId, createdAt])
}

// What super admins changed, for the record.
model AdminLog {
  id         String   @id @default(cuid())
  adminId    String
  adminEmail String
  action     String
  targetType String
  targetId   String
  details    Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

// Inbox: a direct-message thread on a Facebook Page (Messenger) or an
// Instagram professional account.
model Conversation {
  id               String        @id @default(cuid())
  workspaceId      String
  workspace        Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialAccountId  String
  socialAccount    SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  network          SocialNetwork
  externalId       String
  // The person on the other side (PSID / IGSID) — replies go to this id.
  participantId    String
  participantName  String
  lastMessageAt    DateTime
  lastText         String?
  lastFromMe       Boolean       @default(false)
  // Messages from the person newer than the last time someone opened it.
  unread           Int           @default(0)
  readAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  messages Message[]

  @@unique([socialAccountId, externalId])
  @@index([workspaceId, lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  externalId     String
  fromMe         Boolean
  text           String
  // [{ type, url }] for photos, files, stickers, shares.
  attachments    Json?
  sentAt         DateTime
  // Loudpilot user who sent the reply (null for messages read from Meta).
  sentById       String?

  @@unique([conversationId, externalId])
  @@index([conversationId, sentAt])
}

// What the owner told the AI when it asked (audience, locations, offers…),
// so it never asks the same thing twice and every generator knows it.
model BrandFact {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  question    String
  answer      String
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, question])
}

enum VideoStatus {
  DRAFT
  RENDERING
  READY
  FAILED
}

// Studio video: scenes (photo, clip or colour) with on-screen text, motion,
// voice-over and music, rendered to MP4 with ffmpeg (src/lib/video-render.ts).
model Video {
  id            String      @id @default(cuid())
  workspaceId   String
  workspace     Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name          String
  // 9:16, 4:5, 1:1 or 16:9.
  format        String      @default("9:16")
  data          Json
  status        VideoStatus @default(DRAFT)
  error         String?
  // The rendered MP4 (Media kind VIDEO) once READY.
  outputMediaId String?
  renderedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([workspaceId, updatedAt])
}

enum ClipStatus {
  PENDING
  DONE
  FAILED
}

// An AI video clip being generated by Google Veo (a long-running operation).
// Credits are taken when it starts and given back if it fails.
model ClipJob {
  id          String     @id @default(cuid())
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accountId   String
  // The Studio video and scene waiting for it, if any.
  videoId     String?
  sceneId     String?
  prompt      String
  // Photo to animate (image-to-video).
  imageId     String?
  // Character to keep consistent (Veo reference images).
  characterId String?
  quality     String
  aspect      String
  seconds     Int
  credits     Int
  operation   String?
  status      ClipStatus @default(PENDING)
  error       String?
  mediaId     String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, updatedAt])
  @@index([workspaceId, createdAt])
}

// App-wide settings edited by super admins (e.g. "pricing").
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// A person, mascot or product kept the same across AI clips: 1–3 photos sent
// to Veo as reference images, plus a short description added to the prompt.
model Character {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String    @default("")
  // Media ids (IMAGE) of the reference photos.
  photoIds    String[]
  // The uploader confirmed they may use this person's likeness.
  consentAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
}

// One day of a website from Google Analytics 4, in the property's time zone.
model WebsiteDay {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accountId   String
  account     SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // YYYY-MM-DD, like AdInsightDay.
  date        String
  sessions    Int           @default(0)
  users       Int           @default(0)
  newUsers    Int           @default(0)
  engaged     Int           @default(0)
  // Key events (GA4 conversions): sign-ups, leads, purchases…
  keyEvents   Float         @default(0)
  revenue     Float         @default(0)
  // [{ channel, sessions, keyEvents }] and { eventName: count }.
  channels    Json          @default("[]")
  events      Json          @default("{}")
  // Sessions and key events per UTM campaign (utm_campaign): [{ campaign, sessions, keyEvents }].
  campaigns   Json          @default("[]")
  updatedAt   DateTime      @updatedAt

  @@unique([accountId, date])
  @@index([workspaceId, date])
}

// A competitor the owner follows: its website is read into a profile like
// the company's own, and it is compared in a CompetitorReport.
model Competitor {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  website     String?
  facebook    String?
  instagram   String?
  // What the owner knows (prices, strengths, ads they saw…).
  notes       String    @default("")
  // CompanyProfile read from the website (see src/lib/ai.ts).
  profile     Json?
  analyzedAt  DateTime?
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
}

// "Us vs them": the comparison table, where the company wins, gaps and
// actions — written by the AI from the profiles.
model CompetitorReport {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  language    String
  data        Json
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
}

// The brand's rules: read from the owner's brandbook (PDF / images) or
// created with AI. Applying it fills the brand kit; the AI follows it.
model Brandbook {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // UPLOAD or GENERATED.
  source      String
  // BrandbookData (src/lib/ai.ts).
  data        Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// A published Facebook or Instagram post promoted with the workspace's ad
// account ("Boost"): one campaign → ad set → ad built from the post itself.
model Boost {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveryId  String
  delivery    PostDelivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  // The META_ADS account that pays.
  adAccountId String
  adAccount   SocialAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  // AWARENESS | ENGAGEMENT | TRAFFIC
  goal        String
  // Per day, in the ad account currency (major units).
  dailyBudget Float
  currency    String?
  startsAt    DateTime
  endsAt      DateTime
  // { countries, ageMin, ageMax, gender, placements, category }
  audience    Json
  // ACTIVE | PAUSED | FAILED
  status      String
  error       String?
  campaignExternalId String?
  adSetExternalId    String?
  adExternalId       String?
  adCampaignId String?
  adCampaign   AdCampaign?  @relation(fields: [adCampaignId], references: [id], onDelete: SetNull)
  createdById  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([deliveryId])
  @@index([workspaceId, createdAt])
}

// A check of the company website: TRACKING (Meta Pixel, Conversions API,
// Google tags), SEO (Search Console + page audit) or GEO (visibility in AI
// answers). The latest one per kind is shown.
model WebsiteAudit {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind        String
  url         String?
  result      Json
  createdAt   DateTime  @default(now())

  @@index([workspaceId, kind, createdAt])
}
